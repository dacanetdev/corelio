@page "/reportes"
@using Corelio.BlazorApp.Resources
@using Corelio.BlazorApp.Models.Reports
@using Corelio.BlazorApp.Services.Reports
@using Microsoft.Extensions.Localization
@using MudBlazor
@using System.Globalization
@inject IStringLocalizer<SharedResource> L
@inject IDashboardHttpService DashboardService
@inject NavigationManager Nav

<PageTitle>@L["Reports"] - Corelio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h5" GutterBottom="true">@L["ReportDashboard"]</MudText>

    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    @* KPI summary row *@
    <MudPaper Elevation="1" Class="pa-4 mb-6">
        @if (_loading)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["LoadingDashboard"]</MudText>
            </MudStack>
        }
        else if (_summary != null)
        {
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Rounded.AttachMoney" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["TodaysSales"]</MudText>
                        <MudText Typo="Typo.h6">
                            @_summary.TodaysSalesTotal.ToString("C", new CultureInfo("es-MX"))
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @_summary.TodaysTransactionCount @L["TodaysTransactions"]
                        </MudText>
                    </MudStack>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Rounded.Warning"
                                 Color="@(_summary.LowStockProductCount > 0 ? Color.Error : Color.Secondary)"
                                 Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["CriticalStock"]</MudText>
                        <MudText Typo="Typo.h6"
                                 Color="@(_summary.LowStockProductCount > 0 ? Color.Error : Color.Default)">
                            @_summary.LowStockProductCount
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Products"]</MudText>
                    </MudStack>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Rounded.ShoppingBag"
                                 Color="@(_summary.PendingPurchaseOrderCount > 0 ? Color.Warning : Color.Secondary)"
                                 Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["PendingPOs"]</MudText>
                        <MudText Typo="Typo.h6"
                                 Color="@(_summary.PendingPurchaseOrderCount > 0 ? Color.Warning : Color.Default)">
                            @_summary.PendingPurchaseOrderCount
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PurchaseOrders"]</MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Right" Class="mt-2">
                @L["LastUpdated"]: @_summary.GeneratedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
            </MudText>
        }
    </MudPaper>

    @* Report navigation cards *@
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="cursor-pointer" @onclick='() => Nav.NavigateTo("/reportes/ventas")'>
                <MudCardContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Rounded.TrendingUp" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6">@L["SalesReport"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            KPIs de ventas, métodos de pago, productos más vendidos y distribución horaria.
                        </MudText>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true">Ver Reporte</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="cursor-pointer" @onclick='() => Nav.NavigateTo("/reportes/inventario")'>
                <MudCardContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Rounded.Inventory" Color="Color.Warning" Size="Size.Large" />
                        <MudText Typo="Typo.h6">@L["InventoryReport"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            Valuación de inventario, costo promedio ponderado y alertas de stock bajo.
                        </MudText>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Warning" FullWidth="true">Ver Reporte</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="cursor-pointer" @onclick='() => Nav.NavigateTo("/reportes/compras")'>
                <MudCardContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Rounded.ShoppingCart" Color="Color.Success" Size="Size.Large" />
                        <MudText Typo="Typo.h6">@L["PurchaseReport"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            Resumen de compras por proveedor, estado de órdenes y cantidades pendientes.
                        </MudText>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Success" FullWidth="true">Ver Reporte</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private DashboardSummaryModel? _summary;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await DashboardService.GetDashboardSummaryAsync();

        if (result.IsSuccess)
        {
            _summary = result.Value;
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }
}
