@page "/admin/roles"
@using Corelio.BlazorApp.Models.Roles
@using Corelio.BlazorApp.Resources
@using Corelio.BlazorApp.Services.Roles
@using Microsoft.Extensions.Localization
@using MudBlazor
@inject IRoleHttpService RoleService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Roles"] - Corelio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="mb-4">
        <MudText Typo="Typo.h5" GutterBottom="false">@L["Roles"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["RoleListDescription"]</MudText>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_roles.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Rounded.AdminPanelSettings" Color="Color.Secondary" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-2">@L["NoRolesFound"]</MudText>
        </MudPaper>
    }
    else
    {
        <MudExpansionPanels MultiExpansion="true">
            @foreach (var role in _roles)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Rounded.AdminPanelSettings"
                                     Color="@(role.IsSystemRole ? Color.Primary : Color.Default)"
                                     Size="Size.Small" />
                            <div>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.subtitle1"><strong>@role.Name</strong></MudText>
                                    @if (role.IsSystemRole)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                            @L["SystemRole"]
                                        </MudChip>
                                    }
                                    @if (role.IsDefault)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                                            @L["IsDefaultWarehouse"]
                                        </MudChip>
                                    }
                                </MudStack>
                                @if (!string.IsNullOrWhiteSpace(role.Description))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@role.Description</MudText>
                                }
                            </div>
                            <MudSpacer />
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                @role.Permissions.Length @L["Permissions"]
                            </MudChip>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        @if (role.Permissions.Length == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">
                                @L["NoPermissionsAssigned"]
                            </MudText>
                        }
                        else
                        {
                            @foreach (var group in role.Permissions.GroupBy(p => p.Module))
                            {
                                <div class="mb-3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                                        @group.Key.ToUpperInvariant()
                                    </MudText>
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                        @foreach (var perm in group)
                                        {
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@(perm.IsDangerous ? Color.Error : Color.Default)"
                                                     Variant="Variant.Outlined">
                                                @perm.Name
                                            </MudChip>
                                        }
                                    </MudStack>
                                </div>
                            }
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</MudContainer>

@code {
    private List<RoleModel> _roles = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;

        var result = await RoleService.GetRolesAsync();

        if (result.IsSuccess && result.Value is not null)
        {
            _roles = result.Value;
        }
        else
        {
            _error = result.Error ?? L["ErrorLoadingRoles"];
        }

        _loading = false;
    }
}
